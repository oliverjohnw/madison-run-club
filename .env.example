# Copy to .env for local dev. On Railway, set these as service variables instead.

# Signs the login cookie. Any long random string; changing it logs everyone out.
SESSION_SECRET=change-me

# Leave unset locally to use a SQLite file (local.db). Railway's Postgres plugin
# provides this as ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Your admin login. Created on startup if that username doesn't exist yet.
ADMIN_USERNAME=john
ADMIN_PASSWORD=

# Anyone with this code can sign up. Share it in the group chat.
# Leave blank and signup is open to anyone who finds the URL.
CLUB_CODE=moose

# Set to 1 in production so the login cookie is only ever sent over HTTPS.
# HTTPS_ONLY_COOKIES=1
